# Copy this file to .env beside start_windows.bat. Adjust only for your own setup.
# Required before exposing this service remotely. Use a random secret >=32 characters.
# Set the identical value as MEDIA_ENGINE_API_KEY in Vercel project settings.
ENGINE_API_KEY=
# Storage guardrails. Files in the engine's temporary directory count toward the quota.
MAX_STORAGE_GB=8
MIN_FREE_DISK_MB=256
# The website's exact origin(s), comma-separated.
MEDIA_ENGINE_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Optional Chrome extension -> local engine link. Keep false on public/shared services.
MEDIA_ENGINE_ALLOW_CHROME_EXTENSIONS=false
MAX_ACTIVE_JOBS=3
DOWNLOAD_WORKERS=2
MAX_DURATION_SECONDS=10800
MAX_FILE_MB=1024
JOB_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=24
# Set only the actual proxy networks that connect directly to this service.
# Without this, forwarded client headers are ignored (safer default).
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=INFO
